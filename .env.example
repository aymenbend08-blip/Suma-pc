# SUMA Desktop — same Supabase project as SUMA Web.
# Copy to `.env` (gitignored) and fill in real values.
# These are the publishable (anon) key + URL — same ones SUMA Web ships in
# its own client bundle. Never put the service_role key here.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-or-sb_publishable_-key>
